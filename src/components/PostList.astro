---
import ComingSoon from './ComingSoon.astro';
import type { CollectionEntry } from 'astro:content';
import Rich from './Rich.astro';
import { formatDate, spiritCategoryLabel } from '../lib/format';

interface Props {
  posts: CollectionEntry<'spirituality'>[];
}
const { posts } = Astro.props;
---

{
  posts.length ? (
    <ol class="posts">
      {posts.map((p) => (
        <li class="post">
          <time class="post-date" datetime={p.data.date.toISOString()}>
            {formatDate(p.data.date)}
          </time>
          <div>
            <h2 class="post-title">
              <a href={`/spirituality/${p.id}`}>
                <Rich text={p.data.title} />
              </a>
            </h2>
            <p>
              <Rich text={p.data.summary} />
            </p>
            <div class="meta">
              <a class="pill" href={`/spirituality/topic/${p.data.category}`}>
                {spiritCategoryLabel[p.data.category]}
              </a>
              {p.data.portion && (
                <span class="pill pill-future">
                  <Rich text={p.data.portion} />
                </span>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <ComingSoon
      title="The first reflections are being written"
      text="Torah thoughts and reflections on faith, spiritual growth and the meeting of the divine and the psychological will be posted here."
      cta="Get word when a new reflection is posted"
    />
  )
}

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 50rem;
  }
  .post {
    display: grid;
    gap: 0.25rem 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .post {
      grid-template-columns: 10rem 1fr;
    }
  }
  .post-date {
    font-size: 0.9rem;
    color: var(--ink-faint);
    padding-top: 0.4rem;
  }
  .post-title {
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    margin-bottom: 0.35em;
  }
  .post-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .post-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .post p {
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
  a.pill {
    text-decoration: none;
  }
  a.pill:hover {
    border-color: var(--accent);
    color: var(--ink);
  }
</style>
