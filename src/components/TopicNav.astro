---
import { spiritCategoryLabel } from '../lib/format';
interface Props {
  current?: string;
}
const { current } = Astro.props;
const cats = Object.entries(spiritCategoryLabel);
---

<nav class="topics" aria-label="Topics">
  <a href="/spirituality" aria-current={!current ? 'page' : undefined}>All</a>
  {cats.map(([key, label]) => <a href={`/spirituality/topic/${key}`} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
</nav>

<style>
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .topics a {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .topics a:hover {
    background: var(--accent-wash);
  }
  .topics a[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
</style>
