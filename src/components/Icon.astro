---
/** Small inline icon set (decorative by default). */
interface Props {
  name: 'x' | 'soundcloud' | 'youtube' | 'instagram' | 'facebook' | 'spotify' | 'link' | 'sun' | 'moon' | 'menu' | 'close' | 'chevron' | 'play' | 'music' | 'arrow';
  size?: number;
  label?: string;
}
const { name, size = 20, label } = Astro.props;
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" {...a11y}>
  {name === 'x' && <path d="M4 4l16 16M20 4L4 20" />}
  {name === 'soundcloud' && (
    <g>
      <path d="M10 17V9.5M7 17v-5M4 17v-3M13 17V8" />
      <path d="M13 8a5 5 0 0 1 5 4.2 2.9 2.9 0 1 1 .5 4.8H13" />
    </g>
  )}
  {name === 'youtube' && (
    <g>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'instagram' && (
    <g>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
    </g>
  )}
  {name === 'facebook' && <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5a.5.5 0 0 1 .5-.5z" />}
  {name === 'spotify' && (
    <g>
      <circle cx="12" cy="12" r="9.5" />
      <path d="M7.5 9.5c3-1 6.5-.7 9 .8M8 12.5c2.5-.7 5.2-.4 7.3.8M8.6 15.3c2-.5 3.9-.3 5.6.6" />
    </g>
  )}
  {name === 'link' && (
    <g>
      <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" />
      <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
    </g>
  )}
  {name === 'sun' && (
    <g>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </g>
  )}
  {name === 'moon' && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'chevron' && <path d="M6 9l6 6 6-6" />}
  {name === 'play' && <path d="M8 5v14l11-7z" fill="currentColor" stroke="none" />}
  {name === 'music' && (
    <g>
      <path d="M9 18V5l11-2v13" />
      <circle cx="6.5" cy="18" r="2.5" />
      <circle cx="17.5" cy="16" r="2.5" />
    </g>
  )}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
