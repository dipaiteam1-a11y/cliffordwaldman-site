---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Rich from './Rich.astro';
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  narrow?: boolean;
  /** Optional photo, shown on the right and fading into the night sky. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** CSS object-position for the photo, e.g. "70% 30%". */
  imagePosition?: string;
}
const { eyebrow, title, lede, narrow, image, imageAlt = '', imagePosition = 'center' } = Astro.props;
---

<section class:list={['page-hero on-dark night-sky', { 'has-photo': image }]}>
  {
    image && (
      <div class="hero-photo">
        <Image src={image} alt={imageAlt} widths={[640, 1024, 1600]} sizes="(min-width: 56rem) 60vw, 100vw" style={`object-position:${imagePosition}`} loading="eager" />
      </div>
    )
  }
  <div class:list={['wrap', { 'wrap-narrow': narrow }]}>
    <div class="hero-text">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1><Rich text={title} /></h1>
      {lede && <p class="lede"><Rich text={lede} /></p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .hero-photo {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 22rem;
    width: 100%;
    margin-top: calc(-1 * clamp(3.5rem, 9vw, 7rem));
    margin-bottom: 1.5rem;
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, #120e16 100%);
  }
  .hero-text {
    position: relative;
  }
  @media (min-width: 56rem) {
    .has-photo {
      min-height: 30rem;
      display: flex;
      align-items: center;
    }
    .has-photo > .wrap {
      width: 100%;
    }
    .hero-photo {
      position: absolute;
      inset: 0 0 0 auto;
      width: 62%;
      max-height: none;
      aspect-ratio: auto;
      margin: 0;
      z-index: -1;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
    }
    .hero-photo::after {
      background:
        linear-gradient(90deg, rgb(17 13 21 / 0.6) 0%, rgb(17 13 21 / 0.2) 40%, transparent 70%),
        linear-gradient(180deg, transparent 70%, rgb(17 13 21 / 0.7) 100%);
    }
    .has-photo .hero-text {
      max-width: 34rem;
    }
  }
</style>
