---
import Rich from './Rich.astro';
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  narrow?: boolean;
}
const { eyebrow, title, lede, narrow } = Astro.props;
---

<section class="page-hero on-dark night-sky">
  <div class:list={['wrap', { 'wrap-narrow': narrow }]}>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1><Rich text={title} /></h1>
    {lede && <p class="lede"><Rich text={lede} /></p>}
    <slot />
  </div>
</section>
