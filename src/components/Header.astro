---
import { nav, site } from '../config/site';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  section?: string;
}
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const section = Astro.props.section;

const isCurrent = (href: string) => path === href;
const inSection = (href: string) => {
  if (section) return section === href;
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
};
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name}, ${site.owner}: home`}>
      <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
        <path d="M8 36V19a12 12 0 0 1 24 0v17" fill="none" stroke="currentColor" stroke-width="2.2" />
        <circle cx="20" cy="25" r="4.2" class="brand-flame" />
      </svg>
      <span class="brand-text">
        <span class="brand-name">{site.name}</span>
        <span class="brand-owner">{site.owner}</span>
      </span>
    </a>

    <div class="bar-tools">
      <div class="header-socials"><SocialLinks /></div>
      <ThemeToggle />
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
        <span class="menu-open"><Icon name="menu" /></span>
        <span class="menu-close"><Icon name="close" /></span>
        <span class="menu-label">Menu</span>
      </button>
    </div>
  </div>

  <nav id="site-nav" class="site-nav" aria-label="Main">
    <ul class="wrap nav-list">
      {
        nav.map((item) =>
          item.children ? (
            <li class="nav-item has-children">
              <details class="nav-details" data-nav-details>
                <summary class:list={['nav-link', { active: inSection(item.href) || item.children.some((c) => inSection(c.href)) }]}>
                  {item.label}
                  <Icon name="chevron" size={16} />
                </summary>
                <ul class="subnav">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                        <span class="sub-label">{c.label}</span>
                        {c.description && <span class="sub-desc">{c.description}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li class="nav-item">
              <a
                class:list={['nav-link', { active: inSection(item.href), hearth: item.href === '/community' }]}
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
      <li class="nav-socials"><SocialLinks variant="labels" /></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const navEl = document.getElementById('site-nav');
  const details = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-nav-details]'));
  const desktop = window.matchMedia('(min-width: 64rem)');

  const setMenu = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    navEl?.classList.toggle('open', open);
  };
  btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));

  // Only one dropdown open at a time on desktop.
  details.forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open && desktop.matches) details.forEach((o) => o !== d && (o.open = false));
    }),
  );

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openD = details.find((d) => d.open);
    if (openD) {
      openD.open = false;
      openD.querySelector('summary')?.focus();
    } else if (btn?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      btn.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!desktop.matches) return;
    details.forEach((d) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
  });

  // Close dropdowns when focus leaves them (keyboard users).
  details.forEach((d) =>
    d.addEventListener('focusout', (e) => {
      if (desktop.matches && !d.contains(e.relatedTarget as Node)) d.open = false;
    }),
  );

  desktop.addEventListener('change', () => setMenu(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--ink);
  }
  .brand-mark {
    width: 2.1rem;
    height: 2.1rem;
    color: var(--accent);
    flex: none;
  }
  .brand-flame {
    fill: var(--hearth-2);
  }
  .brand-text {
    display: grid;
    line-height: 1.1;
  }
  .brand-name {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 1.3rem;
    font-weight: 500;
  }
  .brand-owner {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .bar-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header-socials {
    display: none;
  }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.5rem;
    padding: 0 0.9rem 0 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }
  .menu-close {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .menu-open {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .menu-close {
    display: inline;
  }
  :global(html:not(.js)) .menu-btn,
  :global(html:not(.js)) .theme-toggle {
    display: none;
  }

  /* ---- Mobile nav: collapsed panel (visible without JS) ---- */
  .site-nav {
    border-top: 1px solid var(--line);
  }
  :global(html.js) .site-nav {
    display: none;
  }
  :global(html.js) .site-nav.open {
    display: block;
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
  }
  .nav-list {
    list-style: none;
    margin: 0;
    padding-block: 0.75rem 1.25rem;
    display: grid;
    gap: 0.1rem;
  }
  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem;
    padding: 0.7rem 0.25rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
    font-size: 1.05rem;
    cursor: pointer;
    list-style: none;
    border-radius: 8px;
  }
  .nav-link::-webkit-details-marker {
    display: none;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
  }
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
  .nav-details[open] > summary :global(svg) {
    transform: rotate(180deg);
  }
  .nav-details summary :global(svg) {
    transition: transform 0.2s;
  }
  .subnav {
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0 0 0 0.75rem;
    border-left: 2px solid var(--line);
  }
  .subnav a {
    display: grid;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
  }
  .subnav a:hover,
  .subnav a[aria-current='page'] {
    background: var(--accent-wash);
  }
  .sub-label {
    font-weight: 600;
  }
  .sub-desc {
    font-size: 0.88rem;
    color: var(--ink-faint);
  }
  .nav-socials {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  /* ---- Desktop ---- */
  @media (min-width: 64rem) {
    .header-socials {
      display: block;
    }
    .menu-btn {
      display: none !important;
    }
    :global(html.js) .site-nav,
    .site-nav {
      display: block;
    }
    .nav-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.15rem 0.35rem;
      padding-block: 0.15rem 0.35rem;
    }
    .nav-item {
      position: relative;
    }
    .nav-link {
      font-size: 0.98rem;
      padding: 0.45rem 0.7rem;
      justify-content: flex-start;
    }
    .nav-link.hearth {
      background: var(--accent-wash);
      border-radius: 999px;
      padding-inline: 0.95rem;
    }
    .subnav {
      position: absolute;
      top: calc(100% + 0.35rem);
      left: 50%;
      transform: translateX(-50%);
      min-width: 17rem;
      padding: 0.5rem;
      background: var(--bg-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .nav-socials {
      display: none;
    }
  }
</style>
