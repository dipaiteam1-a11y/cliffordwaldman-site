---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const page = (await getEntry('pages', 'my-story'))!;
const essay = (await getEntry('pages', 'music-essay'))!;
const { Content } = await render(page);
const { Content: Essay } = await render(essay);
const { headings } = await render(page);
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHero
    eyebrow={page.data.eyebrow}
    title="My Story"
    lede="A personal story and a professional one, told together, because they were never really separate."
  />

  <div class="wrap story-grid">
    <aside class="story-toc" aria-labelledby="toc-heading">
      <p id="toc-heading" class="toc-title">On this page</p>
      <ol>
        {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        <li><a href="#essay">An essay about music</a></li>
      </ol>
    </aside>

    <div>
      <article class="prose">
        <Content />
      </article>

      <section id="essay" class="essay" aria-labelledby="essay-heading">
        <span class="eyebrow">{essay.data.eyebrow}</span>
        <h2 id="essay-heading" class="essay-title">An essay about music</h2>
        <div class="prose essay-body">
          <Essay />
        </div>
      </section>

      <div class="divider-ornament" aria-hidden="true"></div>

      <nav class="story-next" aria-label="Continue exploring">
        <a class="card" href="/music"><span class="eyebrow">Next</span><span class="next-title">Hear the music</span></a>
        <a class="card" href="/psychology"><span class="eyebrow">Professional</span><span class="next-title">Clinical psychology</span></a>
        <a class="card" href="/community"><span class="eyebrow">Together</span><span class="next-title">The Gathering Place</span></a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .story-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 60rem) {
    .story-grid {
      grid-template-columns: 14rem 1fr;
      gap: 4rem;
    }
    .story-toc {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      align-self: start;
    }
  }
  .toc-title {
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }
  .story-toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 2px solid var(--line);
    font-size: 0.98rem;
  }
  .story-toc li {
    padding: 0.2rem 0;
  }
  .story-toc a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .story-toc a:hover {
    color: var(--accent);
  }
  .essay {
    margin-top: 3.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    max-width: calc(var(--measure) + 6rem);
  }
  .essay-title {
    font-style: italic;
  }
  .essay-body {
    font-size: 1.15rem;
  }
  .story-next {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
  }
  .story-next a {
    text-decoration: none;
    color: var(--ink);
  }
  .story-next .eyebrow {
    margin-bottom: 0.2rem;
  }
  .next-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
</style>
