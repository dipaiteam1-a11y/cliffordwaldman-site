---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rich from '../../components/Rich.astro';
import { formatDate, spiritCategoryLabel } from '../../lib/format';

export async function getStaticPaths() {
  const posts = (await getCollection('spirituality', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}

interface Props {
  post: CollectionEntry<'spirituality'>;
  newer?: CollectionEntry<'spirituality'>;
  older?: CollectionEntry<'spirituality'>;
}
const { post, newer, older } = Astro.props;
const d = post.data;
const { Content } = await render(post);
---

<BaseLayout title={d.title} description={d.summary} section="/spirituality">
  <article class="wrap wrap-narrow chapter-page spirit">
    <a class="back-link" href="/spirituality">Spirituality & Torah</a>
    <span class="eyebrow"><a href={`/spirituality/topic/${d.category}`}>{spiritCategoryLabel[d.category]}</a></span>
    <h1><Rich text={d.title} /></h1>
    <p class="meta">
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      {d.portion && <span><Rich text={d.portion} /></span>}
    </p>
    <div class="divider-ornament" aria-hidden="true"></div>
    <div class="prose"><Content /></div>
    {
      d.tags.length > 0 && (
        <p class="meta tags">
          {d.tags.map((t) => (
            <span class="pill">#{t}</span>
          ))}
        </p>
      )
    }
    <nav class="pager" aria-label="More posts">
      {older ? <a href={`/spirituality/${older.id}`} rel="prev"><span>Older</span><Rich text={older.data.title} /></a> : <span />}
      {newer && <a class="pager-next" href={`/spirituality/${newer.id}`} rel="next"><span>Newer</span><Rich text={newer.data.title} /></a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .spirit {
    --accent: var(--door-spirit);
    --accent-wash: color-mix(in srgb, var(--door-spirit) 14%, var(--bg));
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .tags {
    margin-top: 2rem;
  }
</style>
