---
import { isPublic } from '../../../lib/visibility';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import PostList from '../../../components/PostList.astro';
import TopicNav from '../../../components/TopicNav.astro';
import { spiritCategoryLabel } from '../../../lib/format';

export function getStaticPaths() {
  return Object.keys(spiritCategoryLabel).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const label = spiritCategoryLabel[category!];
const posts = (await getCollection('spirituality', ({ data }) => isPublic(data) && data.category === category)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title={`${label} · Spirituality`} description={`${label}: posts by Clifford Waldman.`} section="/spirituality">
  <div class="spirit">
    <PageHero eyebrow="Spirituality & Torah" title={label} />
    <div class="wrap">
      <TopicNav current={category} />
      <PostList posts={posts} />
    </div>
  </div>
</BaseLayout>

<style>
  .spirit {
    --accent: var(--door-spirit);
    --accent-wash: color-mix(in srgb, var(--door-spirit) 14%, var(--bg));
  }
</style>
