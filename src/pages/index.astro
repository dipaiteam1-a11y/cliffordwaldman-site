---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DoorsMap from '../components/DoorsMap.astro';
import SongCard from '../components/SongCard.astro';
import SignupForm from '../components/SignupForm.astro';
import Rich from '../components/Rich.astro';

const songs = (await getCollection('songs', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const intro = "[Clifford's one-paragraph introduction: who he is and what he does, in his own voice.]";

const worlds = [
  {
    title: 'Music & creative work',
    text: "[Clifford's sentence about his music and creative world.] Songs with their lyrics shown beside the music, and the Lollipop Cruise universe.",
    href: '/music',
    cta: 'Listen',
  },
  {
    title: 'Psychology',
    text: "[Clifford's sentence about his clinical work.] Professional background, areas of work and how to get in touch.",
    href: '/psychology',
    cta: 'Clinical practice',
  },
  {
    title: 'Spirituality & teaching',
    text: "[Clifford's sentence about his spiritual and teaching work.] Torah thoughts, reflections, workshops and lectures.",
    href: '/spirituality',
    cta: 'Read reflections',
  },
];

const starts = [
  { from: 'Came from SoundCloud?', to: 'Hear the songs with their lyrics', href: '/music' },
  { from: 'Came from YouTube?', to: 'Watch videos, talks and interviews', href: '/videos' },
  { from: 'Came from X?', to: 'Read essays and reflections', href: '/writing' },
  { from: 'New here?', to: 'Start with my story', href: '/my-story' },
  { from: 'An artist?', to: 'The Witnessing Groups', href: '/workshops/witnessing-groups' },
  { from: 'Looking for a psychologist?', to: 'Clinical psychology & inquiries', href: '/psychology' },
  { from: 'Organising an event?', to: 'Workshops & lectures', href: '/workshops' },
  { from: 'Want to talk?', to: 'Get in touch', href: '/contact' },
];
---

<BaseLayout>
  <section class="home-hero">
    <div class="wrap home-hero-grid">
      <div>
        <span class="eyebrow">Clifford Waldman</span>
        <h1>Come in. <em>This is where it all gathers.</em></h1>
        <p class="lede"><Rich text={intro} /></p>
        <p class="hero-sub">
          Music and lyrics, writing, clinical psychology, Torah and spiritual reflection, workshops, and a growing
          community, all under one roof.
        </p>
        <div class="btn-row">
          <a class="btn" href="/music">Listen to the music</a>
          <a class="btn btn-ghost" href="/my-story">Read my story</a>
        </div>
      </div>
      <figure class="hero-portrait">
        <div class="portrait-frame">
          <mark class="placeholder">[Placeholder: portrait photo of Clifford]</mark>
        </div>
      </figure>
    </div>
  </section>

  <section class="section doors-section" aria-labelledby="doors-heading">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">The house</span>
        <h2 id="doors-heading">Every door leads to the same hearth</h2>
        <p>
          Each part of this site is a door. Walk through any of them and you'll find the same person, and the same
          invitation to sit down and stay a while.
        </p>
      </div>
      <DoorsMap />
    </div>
  </section>

  <section class="section section-sunk" aria-labelledby="worlds-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What I do</span>
        <h2 id="worlds-heading">One life, several rooms</h2>
      </div>
      <div class="grid grid-3">
        {
          worlds.map((w) => (
            <article class="card">
              <h3>
                <a href={w.href}>{w.title}</a>
              </h3>
              <p>
                <Rich text={w.text} />
              </p>
              <span class="link-arrow meta" aria-hidden="true">
                {w.cta}
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="music-heading">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <span class="eyebrow">Music & lyrics</span>
          <h2 id="music-heading">Listen with the words beside you</h2>
          <p>Every song page shows the exact lyrics next to the music. The current line lights up as it's sung, and you can select any line to jump to it.</p>
        </div>
        <a class="link-arrow" href="/music">All songs</a>
      </div>
      <div class="grid grid-3">
        {songs.map((song) => <SongCard song={song} />)}
      </div>
    </div>
  </section>

  <section class="section section-sunk" aria-labelledby="gp-heading">
    <div class="wrap gp-grid">
      <div>
        <span class="eyebrow">The Gathering Place</span>
        <h2 id="gp-heading">What is The Gathering Place?</h2>
        <p>
          It's the heart of this site: a place for conversation, questions and shared learning around everything you
          find here. Music, psychology, Torah, creativity, and the people who care about them.
        </p>
        <p><Rich text="[Clifford's sentence on why he's creating The Gathering Place.]" /></p>
        <p>The community space is being built now. Join the list and you'll be among the first invited in.</p>
        <a class="link-arrow" href="/community">What's coming</a>
      </div>
      <div class="card gp-card">
        <h3>Join the list</h3>
        <SignupForm name="gathering-list" id="home-signup" submitLabel="Count me in" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="start-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Where to start</span>
        <h2 id="start-heading">However you arrived, here's a good first step</h2>
      </div>
      <ul class="starts">
        {
          starts.map((s) => (
            <li>
              <a href={s.href}>
                <span class="start-from">{s.from}</span>
                <span class="start-to">{s.to}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2rem, 5vw, 3rem);
    overflow: hidden;
  }
  .home-hero::before {
    content: '';
    position: absolute;
    right: -10%;
    top: -30%;
    width: min(80vw, 52rem);
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--hearth-1) 45%, transparent), transparent 62%);
    z-index: -1;
  }
  .home-hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .home-hero-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  .home-hero h1 {
    max-width: 14ch;
  }
  .home-hero h1 em {
    display: block;
    font-style: italic;
    color: var(--accent);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .hero-sub {
    color: var(--ink-soft);
    max-width: 36rem;
  }
  .hero-portrait {
    margin: 0;
  }
  .portrait-frame {
    aspect-ratio: 4 / 5;
    max-width: 24rem;
    margin-inline: auto;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    background:
      radial-gradient(circle at 50% 75%, color-mix(in srgb, var(--hearth-1) 55%, transparent), transparent 60%),
      var(--bg-sunk);
    border: 1.5px solid var(--line-strong);
    box-shadow: var(--shadow);
  }
  .center {
    text-align: center;
    margin-inline: auto;
  }
  .split {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .split > div {
    max-width: var(--measure);
  }
  .gp-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 56rem) {
    .gp-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .gp-grid > div > p {
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .starts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .starts a {
    display: grid;
    gap: 0.15rem;
    height: 100%;
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s, background-color 0.2s;
  }
  .starts a:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--ink);
  }
  .start-from {
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
  .start-to {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .start-to::after {
    content: ' →';
    color: var(--accent);
  }
</style>
