---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DoorsMap from '../components/DoorsMap.astro';
import SongCard from '../components/SongCard.astro';
import SignupForm from '../components/SignupForm.astro';
import Rich from '../components/Rich.astro';
import { Image } from 'astro:assets';
import sunsetPhoto from '../assets/clifford/sunset-guitar.webp';
import stagePhoto from '../assets/clifford/stage-microphone.webp';
import studyPhoto from '../assets/clifford/study-portrait.webp';
import montagePhoto from '../assets/clifford/gathering-montage.webp';

const songs = (await getCollection('songs', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const intro = "[Clifford's one-paragraph introduction: who he is and what he does, in his own voice.]";

const worlds = [
  {
    title: 'Music & creative work',
    text: "[Clifford's sentence about his music and creative world.] Songs with their lyrics shown beside the music, and the Lollipop Cruise universe.",
    href: '/music',
    cta: 'Listen',
    img: stagePhoto,
    alt: 'Clifford Waldman singing on stage',
    pos: '55% 25%',
  },
  {
    title: 'Psychology',
    text: "[Clifford's sentence about his clinical work.] Professional background, areas of work and how to get in touch.",
    href: '/psychology',
    cta: 'Clinical practice',
    img: studyPhoto,
    alt: 'Clifford Waldman in his study',
    pos: '40% 30%',
  },
  {
    title: 'Spirituality & teaching',
    text: "[Clifford's sentence about his spiritual and teaching work.] Torah thoughts, reflections, workshops and lectures.",
    href: '/spirituality',
    cta: 'Read reflections',
    img: montagePhoto,
    alt: 'Clifford Waldman at sunset above Jerusalem, with a Torah scroll and books',
    pos: '58% 30%',
  },
];

const starts = [
  { from: 'Came from SoundCloud?', to: 'Hear the songs with their lyrics', href: '/music' },
  { from: 'Came from YouTube?', to: 'Watch videos, talks and interviews', href: '/videos' },
  { from: 'Came from X?', to: 'Read essays and reflections', href: '/writing' },
  { from: 'New here?', to: 'Start with my story', href: '/my-story' },
  { from: 'An artist?', to: 'The Witnessing Groups', href: '/workshops/witnessing-groups' },
  { from: 'Looking for a psychologist?', to: 'Clinical psychology & inquiries', href: '/psychology' },
  { from: 'Organising an event?', to: 'Workshops & lectures', href: '/workshops' },
  { from: 'Want to talk?', to: 'Get in touch', href: '/contact' },
];
---

<BaseLayout>
  <section class="home-hero on-dark night-sky">
    <div class="embers" aria-hidden="true">
      {Array.from({ length: 16 }, (_, i) => <span style={`--i:${i}`} />)}
    </div>
    <div class="home-hero-photo">
      <Image
        src={sunsetPhoto}
        alt="Clifford Waldman with his guitar at sunset, looking out over Jerusalem"
        widths={[640, 1024, 1600, 1942]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap home-hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Clifford Waldman</span>
        <h1>Come in. <em class="glow-text">This is where it all gathers.</em></h1>
        <p class="lede"><Rich text={intro} /></p>
        <p class="hero-sub">
          Music and lyrics, writing, clinical psychology, Torah and spiritual reflection, workshops, and a growing
          community, all under one roof.
        </p>
        <div class="btn-row">
          <a class="btn" href="/music">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
            Listen to the music
          </a>
          <a class="btn btn-ghost" href="/my-story">Read my story</a>
        </div>
        {
          songs[0] && (
            <a class="now-playing" href={`/music/${songs[0].id}`}>
              <span class="eq" aria-hidden="true">
                <i />
                <i />
                <i />
                <i />
              </span>
              <span class="np-text">
                <span class="np-label">Featured song</span>
                <span class="np-title"><Rich text={songs[0].data.title} /></span>
              </span>
            </a>
          )
        }
      </div>
    </div>
    <div class="hero-marquee" aria-hidden="true">
      <div class="marquee-track">
        {
          [0, 1].map(() => (
            <span>
              Music &amp; Lyrics <b>✦</b> Lollipop Cruise <b>✦</b> Writing <b>✦</b> Psychology <b>✦</b> Torah{' '}
              <b>✦</b> Workshops <b>✦</b> The Gathering Place <b>✦</b>{' '}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section doors-section on-dark" aria-labelledby="doors-heading">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">The house</span>
        <h2 id="doors-heading">Every door leads to <em class="glow-text">the same hearth</em></h2>
        <p>
          Each part of this site is a door. Walk through any of them and you'll find the same person, and the same
          invitation to sit down and stay a while.
        </p>
      </div>
      <DoorsMap />
    </div>
  </section>

  <section class="section section-sunk" aria-labelledby="worlds-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What I do</span>
        <h2 id="worlds-heading">One life, several rooms</h2>
      </div>
      <div class="grid grid-3">
        {
          worlds.map((w) => (
            <article class="card world-card">
              <div class="card-art world-art">
                <Image src={w.img} alt={w.alt} widths={[400, 700]} sizes="(min-width: 64rem) 24rem, 100vw" style={`object-position:${w.pos}`} />
              </div>
              <span class="world-num" aria-hidden="true">0{worlds.indexOf(w) + 1}</span>
              <h3>
                <a href={w.href}>{w.title}</a>
              </h3>
              <p>
                <Rich text={w.text} />
              </p>
              <span class="link-arrow meta" aria-hidden="true">
                {w.cta}
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="music-heading">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <span class="eyebrow">Music & lyrics</span>
          <h2 id="music-heading">Listen with the words beside you</h2>
          <p>Every song page shows the exact lyrics next to the music. The current line lights up as it's sung, and you can select any line to jump to it.</p>
        </div>
        <a class="link-arrow" href="/music">All songs</a>
      </div>
      <div class="grid grid-3">
        {songs.map((song) => <SongCard song={song} />)}
      </div>
    </div>
  </section>

  <section class="section gp-section on-dark night-sky" aria-labelledby="gp-heading">
    <div class="wrap gp-grid">
      <div>
        <span class="eyebrow">The Gathering Place</span>
        <h2 id="gp-heading">What is The Gathering Place?</h2>
        <p>
          It's the heart of this site: a place for conversation, questions and shared learning around everything you
          find here. Music, psychology, Torah, creativity, and the people who care about them.
        </p>
        <p><Rich text="[Clifford's sentence on why he's creating The Gathering Place.]" /></p>
        <p>The community space is being built now. Join the list and you'll be among the first invited in.</p>
        <a class="link-arrow" href="/community">What's coming</a>
      </div>
      <div class="card gp-card">
        <h3>Join the list</h3>
        <SignupForm name="gathering-list" id="home-signup" submitLabel="Count me in" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="start-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Where to start</span>
        <h2 id="start-heading">However you arrived, here's a good first step</h2>
      </div>
      <ul class="starts">
        {
          starts.map((s) => (
            <li>
              <a href={s.href}>
                <span class="start-from">{s.from}</span>
                <span class="start-to">{s.to}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------ Hero */
  .home-hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) 0;
  }
  .home-hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .home-hero-grid {
      grid-template-columns: 1.35fr 1fr;
      gap: 4rem;
    }
  }
  .home-hero h1 {
    font-size: clamp(2.9rem, 6.6vw, 5.4rem);
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.5);
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 12ch;
    margin-bottom: 0.4em;
  }
  .home-hero h1 em {
    display: block;
    font-style: italic;
    font-weight: 400;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    padding-bottom: 0.08em;
  }
  .home-hero .lede {
    color: var(--ink);
  }
  .hero-sub {
    color: var(--ink-soft);
    max-width: 36rem;
  }
  .btn-row {
    margin-top: 2rem;
  }

  /* Clifford at sunset: full-bleed on large screens, a banner on phones */
  .home-hero-photo {
    position: relative;
    margin-top: calc(-1 * clamp(3.5rem, 9vw, 7rem));
    margin-bottom: 1rem;
    aspect-ratio: 4 / 3;
  }
  .home-hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 30%;
  }
  .home-hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(13 10 18 / 0.1) 40%, #110d15 100%);
  }
  @media (min-width: 56rem) {
    .home-hero {
      min-height: min(52rem, calc(100svh - var(--header-h)));
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    .home-hero-photo {
      position: absolute;
      inset: 0;
      margin: 0;
      aspect-ratio: auto;
      z-index: -1;
    }
    .home-hero-photo :global(img) {
      object-position: 34% 30%;
    }
    .home-hero-photo::after {
      background:
        linear-gradient(90deg, #0f0b13 0%, rgb(15 11 19 / 0.88) 28%, rgb(15 11 19 / 0.35) 50%, transparent 70%),
        linear-gradient(180deg, rgb(15 11 19 / 0.35) 0%, transparent 25%, transparent 60%, #120e16 100%);
    }
    .home-hero-grid {
      grid-template-columns: minmax(0, 40rem);
    }
  }
  .now-playing {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.75rem 1.1rem 0.75rem 0.9rem;
    border-radius: 18px;
    background: color-mix(in srgb, #1c1622 78%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--hearth-1) 30%, transparent);
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.9);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.25s, border-color 0.25s;
  }
  .now-playing:hover {
    color: var(--ink);
    transform: translateY(-3px);
    border-color: var(--hearth-1);
  }
  .np-text {
    display: grid;
    line-height: 1.25;
  }
  .np-label {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hearth-1);
  }
  .np-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .eq {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 1.4rem;
  }
  .eq i {
    width: 4px;
    height: 40%;
    border-radius: 2px;
    background: linear-gradient(var(--hearth-1), var(--hearth-2));
  }
  .eq i:nth-child(2) {
    height: 90%;
  }
  .eq i:nth-child(3) {
    height: 60%;
  }
  .eq i:nth-child(4) {
    height: 75%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .eq i {
      animation: eq 1.1s ease-in-out infinite alternate;
    }
    .eq i:nth-child(2) {
      animation-delay: -0.4s;
    }
    .eq i:nth-child(3) {
      animation-delay: -0.8s;
    }
    .eq i:nth-child(4) {
      animation-delay: -0.2s;
    }
  }
  @keyframes eq {
    to {
      height: 20%;
    }
  }

  /* embers drifting up from the hearth */
  .embers {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .embers span {
    position: absolute;
    bottom: -10px;
    left: calc(4% + var(--i) * 6%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--hearth-1);
    box-shadow: 0 0 10px 2px var(--hearth-2);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .embers span {
      animation: rise calc(9s + var(--i) * 0.7s) linear infinite;
      animation-delay: calc(var(--i) * -1.3s);
    }
    .embers span:nth-child(3n) {
      width: 3px;
      height: 3px;
    }
    .embers span:nth-child(4n + 1) {
      width: 5px;
      height: 5px;
    }
  }
  @keyframes rise {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    10% {
      opacity: 0.9;
    }
    50% {
      transform: translate(24px, -45vh);
    }
    85% {
      opacity: 0.5;
    }
    100% {
      transform: translate(-16px, -95vh);
      opacity: 0;
    }
  }

  /* drifting band of section names */
  .hero-marquee {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    border-block: 1px solid color-mix(in srgb, var(--hearth-1) 18%, transparent);
    background: rgb(0 0 0 / 0.18);
    overflow: hidden;
    white-space: nowrap;
  }
  .marquee-track {
    display: inline-flex;
    padding-block: 1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: var(--ink-soft);
  }
  .marquee-track span {
    padding-right: 1.5rem;
  }
  .marquee-track b {
    font-style: normal;
    font-weight: 400;
    color: var(--hearth-2);
    margin-inline: 1.25rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 48s linear infinite;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ----------------------------------------------------------- Doors */
  .doors-section {
    background:
      radial-gradient(55% 45% at 50% 60%, color-mix(in srgb, var(--hearth-2) 16%, transparent), transparent 70%),
      linear-gradient(180deg, #1d1316 0%, #120e16 30%, #120e16 100%);
  }

  /* ----------------------------------------------------------- Rooms */
  .world-card {
    overflow: hidden;
  }
  .world-art {
    aspect-ratio: 16 / 10;
  }
  .world-num {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2.6rem;
    line-height: 1;
    margin-bottom: 0.6rem;
    color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .world-card h3 {
    font-size: 1.6rem;
  }

  /* -------------------------------------------------- Gathering place */
  .gp-section .gp-card {
    background: color-mix(in srgb, #1c1622 75%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-color: color-mix(in srgb, var(--hearth-1) 28%, transparent);
  }
  .gp-section .gp-card:hover {
    transform: none;
  }


  .center {
    text-align: center;
    margin-inline: auto;
  }
  .split {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .split > div {
    max-width: var(--measure);
  }
  .gp-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 56rem) {
    .gp-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .gp-grid > div > p {
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .starts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .starts a {
    display: grid;
    gap: 0.15rem;
    height: 100%;
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s, background-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .starts a:hover {
    border-color: var(--accent);
    background: var(--bg-raised);
    color: var(--ink);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .start-from {
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
  .start-to {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .start-to::after {
    content: ' →';
    color: var(--accent);
  }
</style>
