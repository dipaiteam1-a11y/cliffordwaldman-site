# Form handling. Leave blank to use Netlify Forms (works automatically on Netlify).
# On Vercel (or anywhere else) create forms at https://formspree.io and paste the
# full endpoint URLs here, e.g. https://formspree.io/f/abcdwxyz
PUBLIC_CONTACT_FORM_ENDPOINT=
PUBLIC_SIGNUP_FORM_ENDPOINT=

# Show "[Clifford's …]" placeholders and sample entries (songs, posts, workshops…) on the site.
# Useful while filling in content; leave unset or false for the live site.
PUBLIC_SHOW_PLACEHOLDERS=
